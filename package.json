{
  "name": "campplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Éditeur de plans de campements industriels sur photo aérienne originale intacte.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p server/tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "server": "tsx --tsconfig server/tsconfig.json server/src/main.ts",
    "server:bootstrap": "tsx --tsconfig server/tsconfig.json server/scripts/bootstrap.ts",
    "test:server": "vitest run --project server",
    "test:s3": "vitest run --project server server/test/s3.test.ts",
    "server:purge-files": "tsx --tsconfig server/tsconfig.json server/scripts/purge-files.ts",
    "server:backup": "tsx --tsconfig server/tsconfig.json server/scripts/backup.ts",
    "server:migrate": "tsx --tsconfig server/tsconfig.json server/scripts/migrate.ts",
    "server:predeploy": "tsx --tsconfig server/tsconfig.json server/scripts/predeploy.ts",
    "server:backup-bucket": "tsx --tsconfig server/tsconfig.json server/scripts/backup-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "dexie": "^4.4.6",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "konva": "^10.6.0",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
