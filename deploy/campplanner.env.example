# CampPlanner — configuration NON secrète (copier en deploy/campplanner.env, jamais commité).
# Les secrets (mots de passe, URL de connexion) sont dans deploy/secrets/ (voir make-secrets.sh)
# ou dans le coffre de secrets de l'hébergeur (Azure Key Vault, etc.), montés en fichiers et lus
# par les variables *_FILE.

PUBLIC_ORIGIN=https://campplanner.example.org
SESSION_TTL_DAYS=30
SHARED_SESSION_TTL_HOURS=12
MAX_UPLOAD_BYTES=209715200

# Stockage des fichiers : disque (volume) …
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/data/files
# … ou service compatible S3 (identifiants par AWS_ACCESS_KEY_ID(_FILE) / AWS_SECRET_ACCESS_KEY(_FILE)
# ou identité gérée ; jamais ici) :
# STORAGE_DRIVER=s3
# S3_BUCKET=campplanner-fichiers
# S3_REGION=ca-central-1
# S3_ENDPOINT=https://s3.example.org
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=prod/
